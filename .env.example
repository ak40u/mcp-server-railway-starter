# Required. Where clients reach this server. On Railway this is filled in from
# RAILWAY_PUBLIC_DOMAIN automatically; set it by hand only when running locally.
PUBLIC_URL=http://localhost:8123

# Required. The password you type on the login page when a client asks for access.
MCP_ADMIN_PASSWORD=change-me-to-something-long

# Required. Postgres holds OAuth clients, codes and tokens.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mcp

# Optional.
PORT=8123
MCP_SERVER_NAME=mcp-starter
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
